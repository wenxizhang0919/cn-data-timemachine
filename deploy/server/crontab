# 国内服务器定时任务（timemachine 用户的 crontab，北京时间）。
# 改这个文件并推到 GitHub 即可：服务器每次运行 run.sh 时会自动同步到自己的 crontab，不用登录服务器。
#
# 每次运行最多 50 分钟，超时强制结束，不会卡住后面的运行。
# 一天一次的数据源：10:47 / 14:07 / 17:37 / 20:47 先成功者采集，其余自动跳过。
# 一天多次的数据源（如水质，每小时更新）：每天 0:27–22:27 每小时采一次。
#   23 点不采：留出时间让 GitHub 在当天结束前把最后一次推送登记进账本。
# 21:47 兜底：本机的数据源再试一次；GitHub 负责的数据源若今天还没有，由本机代采。
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
47 10 * * * timeout 50m /opt/timemachine/repo/deploy/server/run.sh >> /var/log/timemachine.log 2>&1
7 14 * * *  timeout 50m /opt/timemachine/repo/deploy/server/run.sh >> /var/log/timemachine.log 2>&1
37 17 * * * timeout 50m /opt/timemachine/repo/deploy/server/run.sh >> /var/log/timemachine.log 2>&1
47 20 * * * timeout 50m /opt/timemachine/repo/deploy/server/run.sh >> /var/log/timemachine.log 2>&1
47 21 * * * timeout 50m /opt/timemachine/repo/deploy/server/run.sh --fallback >> /var/log/timemachine.log 2>&1
27 0-22 * * * timeout 50m /opt/timemachine/repo/deploy/server/run.sh --intraday-only >> /var/log/timemachine.log 2>&1
